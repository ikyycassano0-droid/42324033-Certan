   "source": [
    "# 1.g Menampilkan Garis hasil prediksi (Train Set dan Test Set)\n",
    "plt.figure(figsize=(14, 5))\n",
    "\n",
    "# Plot Train Set\n",
    "plt.subplot(1, 2, 1)\n",
    "plt.scatter(X_train, y_train, color=\"blue\", label=\"Data Aktual Train\")\n",
    "plt.plot(\n",
    "    X_train,\n",
    "    model_lr.predict(X_train),\n",
    "    color=\"red\",\n",
    "    linewidth=2,\n",
    "    label=\"Garis Regresi\",\n",
    ")\n",
    "plt.title(\"Regresi: Training Set\")\n",
    "plt.xlabel(\"transaction\")\n",
    "plt.ylabel(\"house price\")\n",
    "plt.legend()\n",
    "\n",
    "# Plot Test Set\n",
    "plt.subplot(1, 2, 2)\n",
    "plt.scatter(X_test, y_test, color=\"green\", label=\"Data Aktual Test\")\n",
    "plt.plot(X_test, y_pred_test, color=\"red\", linewidth=2, label=\"Garis Regresi\")\n",
    "plt.title(\"Regresi: Testing Set\")\n",
    "plt.xlabel(\"transaction\")\n",
    "plt.ylabel(\"house price\")\n",
    "plt.legend()\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
