   ],
   "source": [
    "konsumen = pd.read_csv(\"konsumen.csv\", sep=\";\")\n",
    "konsumen.columns = konsumen.columns.str.strip()\n",
    "\n",
    "for kolom in [\"No\", \"Gaji\", \"Pengeluaran\"]:\n",
    "    if kolom in konsumen.columns:\n",
    "        konsumen[kolom] = pd.to_numeric(konsumen[kolom], errors=\"coerce\")\n",
    "\n",
    "konsumen = konsumen.dropna(subset=[\"Gaji\", \"Pengeluaran\"]).copy()\n",
    "display(konsumen.head(7))"
   ]
  },
