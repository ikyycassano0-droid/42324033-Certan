      ],
      "text/plain": [
       "   Gaji  Pengeluaran  Cluster\n",
       "0  2500         1750        0\n",
       "1  3800         4200        0\n",
       "2  3900         3800        0\n",
       "3  4350         5500        0\n",
       "4  4400         3200        0\n",
       "5  5500         5450        2\n",
       "6  5600         5950        2\n",
       "7  5750         4100        0\n",
