       "9  6900         8500        1"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "fitur_kmeans = [\"Gaji\", \"Pengeluaran\"]\n",
    "X_konsumen = konsumen_model[fitur_kmeans]\n",
    "\n",
    "kmeans = KMeans(n_clusters=3, random_state=42, n_init=10)\n",
    "konsumen_model[\"Cluster\"] = kmeans.fit_predict(X_konsumen)\n",
    "\n",
    "pusat_cluster = pd.DataFrame(kmeans.cluster_centers_, columns=fitur_kmeans)\n",
    "pusat_cluster.index = [f\"Cluster {i}\" for i in pusat_cluster.index]\n",
    "\n",
    "print(\"Pusat cluster:\")\n",
    "display(pusat_cluster.round(3))\n",
    "\n",
    "print(\"Data konsumen beserta cluster:\")\n",
    "display(konsumen_model.head(10))"
   ]
  },
