    "# Soal 2\n",
    "# 1.a Membaca file Sales_Data.csv \n",
    "df2 = pd.read_csv(\"real_estate.csv\", sep=\";\")\n",
    "\n",
    "# 1.b Menampilkan variable dalam dataset\n",
    "print(\"Variabel/Kolom dalam dataset:\")\n",
    "print(df2.columns.tolist())\n",
